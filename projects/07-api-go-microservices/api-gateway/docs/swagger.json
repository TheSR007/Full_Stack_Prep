    "definitions": {
        "handlers.BulkDeleteDTO": {
            "type": "object",
            "properties": {
                "taskIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "t_101",
                        "t_102"
                    ]
                }
            }
        },
        "handlers.BulkUpdateStatusDTO": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "completed"
                },
                "taskIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "t_101",
                        "t_102"
                    ]
                }
            }
        },
        "handlers.CreateSubtaskDTO": {
            "type": "object",
            "properties": {
                "title": {
                    "type": "string",
                    "example": "Verify CORS middleware"
                }
            }
        },
        "handlers.CreateTaskDTO": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "example": "Database"
                },
                "description": {
                    "type": "string",
                    "example": "Configure auto migrations for User and Task models."
                },
                "dueDate": {
                    "type": "string",
                    "example": "2026-08-05"
                },
                "priority": {
                    "type": "string",
                    "example": "high"
                },
                "status": {
                    "type": "string",
                    "example": "todo"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "#gorm",
                        "#sqlite"
                    ]
                },
                "title": {
                    "type": "string",
                    "example": "Setup SQLite GORM Migrations"
                }
            }
        },
        "handlers.ErrorEnvelopeDTO": {
            "type": "object",
            "properties": {
                "error": {},
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "handlers.LoginDTO": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "developer@taskflow.dev"
                },
                "password": {
                    "type": "string",
                    "example": "SecurePassword123!"
                }
            }
        },
        "handlers.MetaDTO": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer",
                    "example": 50
                },
                "page": {
                    "type": "integer",
                    "example": 1
                },
                "total": {
                    "type": "integer",
                    "example": 42
                },
                "totalPages": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "handlers.PaginatedEnvelopeDTO": {
            "type": "object",
            "properties": {
                "data": {},
                "meta": {
                    "$ref": "#/definitions/handlers.MetaDTO"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "handlers.RegisterDTO": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "developer@taskflow.dev"
                },
                "name": {
                    "type": "string",
                    "example": "Dev User"
                },
                "password": {
                    "type": "string",
                    "example": "SecurePassword123!"
                }
            }
        },
        "handlers.SingleEnvelopeDTO": {
            "type": "object",
            "properties": {
                "data": {},
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "handlers.UpdateSubtaskDTO": {
            "type": "object",
            "properties": {
