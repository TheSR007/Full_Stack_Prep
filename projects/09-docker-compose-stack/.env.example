# Environment Variables Configuration Template
# Copy this file to .env for production or development setup

# General Configuration
NODE_ENV=production
PORT=3000
# Relative path routing via Nginx (leave empty for default relative origin fetch)
NEXT_PUBLIC_API_URL=

# Docker Registry Configuration
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_REPO=thesr/fullstack-prep
IMAGE_TAG=latest

# PostgreSQL Database Configuration
POSTGRES_USER=appuser
POSTGRES_PASSWORD=secretpassword123
POSTGRES_DB=taskdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=mongouser
MONGO_INITDB_ROOT_PASSWORD=mongopassword123
MONGO_DB=analyticsdb
MONGO_HOST=mongo
MONGO_PORT=27017

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123

# Service Ports & Hostnames
FRONTEND_PORT=3000
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
WORKER_SERVICE_PORT=8000
NGINX_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Monitoring & Security
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=adminsecret
JWT_SECRET=supersecretjwtkey987654321

# doco-cd GitOps Configuration
GIT_ACCESS_TOKEN=github_pat_11...
WEBHOOK_SECRET=my_doco_webhook_secret_99
